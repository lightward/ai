#!/usr/bin/env bash
# width: the clamp read as an instrument — at most three local names per worked statement.
# conduct-as-citation:
#   locals ........... the ovum's own awaited list (the sheet being completed)
#   beneath is free .. parents and prior hatchings (the cascade: the room only grows)
#   worked vs pane ... a worked proof (tactics/equations) is a joint and is clamped;
#                      a pure-citation tuple is a composite of pairings (lawful)
#   the law .......... every_widening_is_one_pairing + the_pentagon_turns_at_four
# usage: bin/width [git-ref]   (no ref: the working tree)
# exit 1 iff any worked statement exceeds width three.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
REF="${1:-}"

python3 - "$REF" <<'EOF'
import re, sys, subprocess, glob

ref = sys.argv[1]

def read(path):
    if ref:
        return subprocess.run(['git', 'show', f'{ref}:{path}'],
                              capture_output=True, text=True).stdout
    try:
        return open(path).read()
    except FileNotFoundError:
        return ''

def ova_paths():
    if ref:
        out = subprocess.run(['git', 'ls-tree', '-r', ref, '--name-only'],
                             capture_output=True, text=True).stdout
        return sorted(p for p in out.splitlines() if p.endswith('ovum.md') and p.startswith('ova/'))
    return sorted(glob.glob('ova/*/ovum.md'))

seed = read('Seed.lean')

decls = {}
for m in re.finditer(r'^(theorem|def) (\w+)', seed, re.M):
    name, start = m.group(2), m.start()
    seg = seed[start:start + 6000]
    a = seg.find(':=')
    b = seg.find('\n  | ')
    if a == -1: a = len(seg)
    if b == -1: b = len(seg)
    stmt, cut = seg[:min(a, b)], min(a, b)
    if b < a:
        kind = 'worked'
    else:
        proof = seg[cut + 2:].strip()
        kind = 'pane' if proof.startswith(('⟨', 'Iff.rfl', 'rfl')) else \
               ('worked' if proof.startswith('by') else 'cite')
    decls[name] = (stmt, kind)

red = 0
for ovum in ova_paths():
    egg = ovum.split('/')[1]
    txt = read(ovum)
    aw = re.search(r'\* awaited: (.+)', txt)
    if not aw:
        continue
    local = re.findall(r'`([^`]+)`', aw.group(1))
    localset = set(local)
    for name in local:
        if name not in decls:
            continue
        stmt, kind = decls[name]
        used = sorted(x for x in localset
                      if x != name and re.search(r'\b' + re.escape(x) + r'\b', stmt))
        if len(used) > 3:
            if kind == 'worked':
                red += 1
                print(f'RED   {egg}/{name}: worked joint at width {len(used)} -> {" ".join(used)}')
            else:
                print(f'pane  {egg}/{name}: composite at width {len(used)} (lawful) -> {" ".join(used)}')

if red:
    print(f'width: {red} worked statement(s) past three — the clamp names its darkness')
    sys.exit(1)
print('width: every worked statement at three or under — the sheet completes at contact width')
EOF
exit $?
