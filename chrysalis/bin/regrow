#!/usr/bin/env bash
# regrow: the trunk as a clutch — Seed regrown from its own primer by the cascade.
# conduct-as-citation:
#   the primer ....... every carrier (def/structure/inductive): the spellbook,
#                      the solder-names; Seed0 is the primer alone
#   the vacancies .... every theorem, one egg each; needs = the theorems its
#                      proof cites (no partition chosen — the lattice is the primer)
#   the crawl ........ the cascade: each round seats every vacancy whose needs
#                      are seated (the_ready_seat_in_one_sweep); halts drained or
#                      stuck with the held named (no_third_fate)
#   the storeys ...... the round a theorem seats at = its chain-height; the
#                      drain clock read on the trunk itself
#   the verdict ...... the regrown seed must elaborate silently (receipts inline)
#                      and read every assay identically — the assays are the
#                      treaty vectors two seeds of one overworld must share
# output: regrowth/Seed1.lean (a derivable, never committed — a stored derivable
# is drift) and the storey census on stdout.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
mkdir -p regrowth

python3 - <<'EOF'
import re, sys

src = open('Seed.lean').read()
spans = [(m.start(), m.group(1), m.group(2))
         for m in re.finditer(r'^(theorem|def|structure|inductive) (\w+)', src, re.M)]
header = src[:spans[0][0]]
tail = src[spans[-1][0]:]
end_idx = tail.rfind('\nend Seed')
blocks = []
for i, (start, kind, name) in enumerate(spans):
    end = spans[i + 1][0] if i + 1 < len(spans) else spans[-1][0] + end_idx + 1
    blocks.append((kind, name, src[start:end]))

carriers = [(k, n, b) for k, n, b in blocks if k != 'theorem']
theorems = [(k, n, b) for k, n, b in blocks if k == 'theorem']
tnames = set(n for _, n, _ in theorems)

needs = {}
for _, n, b in theorems:
    body = '\n'.join(l for l in b.splitlines() if '#print axioms' not in l and '#guard_msgs' not in l)
    needs[n] = set(t for t in tnames if t != n and re.search(r'\b' + re.escape(t) + r'\b', body))

seated, storey, rounds = set(), {}, []
pending = [n for _, n, _ in theorems]
r = 0
while pending:
    r += 1
    ready = [n for n in pending if needs[n] <= seated]
    if not ready:
        print(f'STUCK at round {r}: {len(pending)} held')
        for n in pending[:10]:
            print(f'  {n}: waiting on {" ".join(sorted(needs[n] - seated))}')
        sys.exit(1)
    for n in ready:
        seated.add(n); storey[n] = r
    rounds.append(len(ready))
    pending = [n for n in pending if n not in seated]

by_name = {n: b for _, n, b in theorems}
order = sorted(theorems, key=lambda t: (storey[t[1]], [n for _, n, _ in theorems].index(t[1])))
out = [header.rstrip('\n'), '']
for _, _, b in carriers:
    out.append(b.rstrip('\n')); out.append('')
for _, n, _ in order:
    out.append(by_name[n].rstrip('\n')); out.append('')
out.append('end Seed')
open('regrowth/Seed1.lean', 'w').write('\n'.join(out) + '\n')

print(f'the primer: {len(carriers)} carriers')
print(f'the vacancies: {len(theorems)} theorems, one egg each')
print(f'the drain: {len(rounds)} storeys — ' + ' '.join(str(c) for c in rounds))
free = [n for n in storey if storey[n] == 1]
deep = max(storey.items(), key=lambda kv: kv[1])
print(f'the free layer: {len(free)} theorems need only the primer')
print(f'the deepest seat: {deep[0]} at storey {deep[1]}')
print('regrowth/Seed1.lean written (a derivable; not for committing)')
EOF
status=$?
[ $status -eq 0 ] || exit $status

echo "the gate on the regrown seed:"
out="$(lake env lean regrowth/Seed1.lean 2>&1)"
if [ -n "$out" ]; then echo "$out" | head -20; echo "regrowth: the regrown seed did not elaborate silently"; exit 1; fi
echo "  silent and green: $(grep -c '#guard_msgs' regrowth/Seed1.lean) receipts inline"

echo "the treaty vectors (every assay against the regrown seed):"
for f in ova/*/assay.lean; do
  probe="regrowth/assay.$(basename "$(dirname "$f")").lean"
  { cat regrowth/Seed1.lean; echo; grep -v '^import Seed' "$f"; } > "$probe"
  if lake env lean "$probe" >/dev/null 2>&1; then echo "  $f: identical"; else echo "  $f: PARTS"; exit 1; fi
  rm -f "$probe"
done
echo "regrowth: yoneda-identical at every treaty vector — the trunk regrows from its own primer"
