#!/usr/bin/env python3

import html
import importlib.machinery
import importlib.util
import os
import re
import textwrap

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
OUT = os.environ.get("FOAM_WIKI_OUT", os.path.join(ROOT, "wiki"))

STRATA = [
    ("Foam", "Foam", "core"),
    ("Foam/Minds", "Foam.Minds", "minds"),
]

CSS = """
:root { --bg: #ffffff; --fg: #1a1a1a; --dim: #6a6a6a; --line: #e0e0e0;
        --comment: #0a7a3d; --name: #1a4fa0; --accent: #8a4fa0; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #101014; --fg: #d8d8dc; --dim: #8a8a90; --line: #2a2a30;
          --comment: #5fd39a; --name: #7fa8e8; --accent: #c39ae0; } }
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--fg); margin: 0 auto; padding: 2rem 1rem 4rem;
       max-width: 60rem; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
       font-size: 14px; line-height: 1.6; }
a { color: var(--name); text-decoration: none; }
a:hover { text-decoration: underline; }
h1 { font-size: 1.2rem; font-weight: 600; }
h2 { font-size: 1rem; font-weight: 600; margin-top: 2rem; }
header .crumb { color: var(--dim); }
pre { overflow-x: auto; white-space: pre-wrap; }
.src { border-left: 2px solid var(--line); padding-left: 1rem; }
.comment { color: var(--comment); }
.guard { font-style: italic; color: var(--dim); }
.decl { color: var(--name); font-weight: 600; }
.kw { color: var(--accent); }
ul.census { list-style: none; padding-left: 0; column-width: 16rem; column-gap: 2rem; }
ul.census li { break-inside: avoid; }
.stratum { color: var(--dim); }
footer { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1rem;
         color: var(--dim); }
.law { border-left: 2px solid var(--comment); padding-left: 1rem; color: var(--dim); }
.gloss { display: block; color: var(--accent); font-style: italic;
         border-left: 2px solid var(--accent); padding-left: 1rem;
         margin: 0.5rem 0 0.25rem; white-space: pre-wrap; }
.famous { font-size: 1.5rem; margin: 0.3rem 0; }
.panel { margin-top: 1.5rem; }
"""

DECL_RE = re.compile(r"^(theorem|def|structure|inductive|abbrev|instance) (\S+)")
IMPORT_RE = re.compile(r"^import ([\w.]+)$")
GUARD_RE = re.compile(r"^(/-- info:|#guard_msgs)")
COMMENT_RE = re.compile(r"^(/--|/-|--)")
NS_RE = re.compile(r"^namespace (\S+)")

ROLES = [
    ("intake — the open hand", [
        "Foam.a_state_answers_every_probe",
        "Foam.only_surprise_extends_reach",
        "Foam.the_window_agrees_or_names_the_gap",
    ]),
    ("egress — the send", [
        "Foam.the_one_way_valve",
        "Foam.a_merge_admits_no_counter",
        "Foam.no_local_counter_reaches_the_foreign_record",
        "Foam.undo_in_an_append_only_world",
    ]),
    ("blind relay — the link", [
        "Foam.Blind",
        "Foam.the_blind_reading_factors",
        "Foam.relay",
        "Foam.a_chain_of_invisibles_is_invisible",
        "Foam.the_relay_goes_unheard",
        "Foam.contact_is_addition_not_fixing",
    ]),
    ("the third seat — where a ring closes", [
        "Foam.the_comparison_is_a_seat",
        "Foam.recognition_widens_the_seat",
    ]),
]


def collect():
    modules = {}
    for base, prefix, stratum in STRATA:
        basedir = os.path.join(ROOT, base)
        rootfile = basedir + ".lean"
        if os.path.exists(rootfile):
            modules[prefix] = (rootfile, stratum)
        for dirpath, _, files in os.walk(basedir):
            for f in sorted(files):
                if f.endswith(".lean"):
                    path = os.path.join(dirpath, f)
                    rel = os.path.relpath(path, basedir)
                    mod = prefix + "." + rel[:-5].replace(os.sep, ".")
                    modules[mod] = (path, stratum)
    return modules


def page(title, body, crumb=""):
    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{html.escape(title)}</title>
<style>{CSS}</style></head><body>
<header><span class="crumb">{crumb}</span><h1>{html.escape(title)}</h1></header>
{body}
<footer><a href="index.html">index</a> · <a href="https://github.com/lightward/foam">github.com/lightward/foam</a></footer>
</body></html>"""


def render_module(mod, path, stratum, known, glosses=None, panels=""):
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    out = []
    in_comment = False
    for line in lines:
        esc = html.escape(line)
        if in_comment:
            out.append(f'<span class="comment">{esc}</span>')
            if "-/" in line:
                in_comment = False
            continue
        m = IMPORT_RE.match(line)
        if m:
            target = m.group(1)
            if target in known:
                esc = f'import <a href="{target}.html">{html.escape(target)}</a>'
            out.append(esc)
            continue
        d = DECL_RE.match(line)
        if d:
            kw, name = d.group(1), d.group(2)
            if glosses:
                base = name[:-len("_statement")] if name.endswith("_statement") else name
                if base in glosses:
                    wrapped = textwrap.fill(glosses[base], width=72)
                    out.append(f'<span class="gloss">{html.escape(wrapped)}</span>')
            anchor = html.escape(name)
            rest = html.escape(line[len(kw) + 1 + len(name):])
            esc = (f'<span class="kw">{kw}</span> '
                   f'<a class="decl" id="{anchor}" href="#{anchor}">{anchor}</a>{rest}')
            out.append(esc)
            continue
        if GUARD_RE.match(line):
            out.append(f'<span class="guard">{esc}</span>')
            continue
        if COMMENT_RE.match(line):
            out.append(f'<span class="comment">{esc}</span>')
            if line.lstrip().startswith("/-") and "-/" not in line:
                in_comment = True
            continue
        out.append(esc)
    src = "\n".join(out)
    body = f'<pre class="src">{src}</pre>' + panels
    crumb = f'<a href="index.html">foam.is</a> · <span class="stratum">{html.escape(stratum)}</span>'
    return page(mod, body, crumb)


def render_index(modules):
    by_stratum = {}
    for mod, (path, stratum) in sorted(modules.items()):
        by_stratum.setdefault(stratum, []).append(mod)
    sections = []
    for _, _, stratum in STRATA:
        mods = [m for m in by_stratum.get(stratum, [])
                if not m.startswith("Foam.Exhibits.")]
        items = "\n".join(
            f'<li><a href="{m}.html">{html.escape(m)}</a></li>' for m in mods)
        epigraph = ""
        if stratum == "core":
            epigraph = ('<p class="law">the existential hardware store is open'
                        ' to all ontologies and ontics — core is a parts'
                        ' catalog for rings; each module page lists the'
                        ' ring-roles its constants equip.</p>')
        sections.append(
            f'<h2>{html.escape(stratum)} <span class="stratum">({len(mods)} modules)</span></h2>'
            f'{epigraph}<ul class="census">{items}</ul>')
    comments = 0
    for mod, (path, _) in modules.items():
        with open(path, encoding="utf-8") as f:
            comments += f.read().count("#print axioms")
    preamble = f"""<p class="law">this site is a class-closed coarse reading of
<a href="https://github.com/lightward/foam">github.com/lightward/foam</a>. </p>"""
    return page("foam — the measurement solution", preamble + "\n".join(sections),
                '<a href="https://foam.is/">foam.is</a>')


def load_counter():
    path = os.path.join(ROOT, "bin", "foam-counter")
    loader = importlib.machinery.SourceFileLoader("foamcounter", path)
    spec = importlib.util.spec_from_loader("foamcounter", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def core_names(modules):
    names = {}
    for mod, (path, stratum) in sorted(modules.items()):
        if stratum != "core":
            continue
        prefix = []
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                n = NS_RE.match(line)
                if n:
                    prefix.append(n.group(1))
                    continue
                if prefix and line.rstrip() == "end " + prefix[-1]:
                    prefix.pop()
                    continue
                d = DECL_RE.match(line)
                if d and d.group(1) != "instance":
                    names[".".join(prefix + [d.group(2)])] = mod
    return names


def link_name(full, names):
    mod = names[full]
    last = full.rsplit(".", 1)[-1]
    return f'<a href="{mod}.html#{html.escape(last)}">{html.escape(full)}</a>'


def mind_panels(mod, spectra, terms, standing, openr, names):
    parts = []
    ports = ""
    if terms:
        terminus = terms[-1]
        ports += (f'<p>terminus, the map\'s W-port: '
                  f'<a href="#{html.escape(terminus)}">{html.escape(terminus)}</a>'
                  f' — (self, pure unknown), sealed open</p>')
    if standing:
        items = " · ".join(
            f'<a href="#{html.escape(s)}_statement">{html.escape(s)}</a>'
            for s in standing)
        ports += f'<p>standing poses, the red of red-green: {items}</p>'
    if openr:
        items = " · ".join(html.escape(o) for o in openr)
        ports += f'<p>open readings, the dark edge: {items}</p>'
    if ports:
        parts.append(f'<div class="panel"><h2>W-ports</h2>{ports}</div>')
    holds = sorted(spectra.get(mod, set()))
    if holds:
        items = "\n".join(f'<li>{link_name(h, names)}</li>' for h in holds)
        parts.append(
            f'<div class="panel"><h2>holdings'
            f' <span class="stratum">({len(holds)} core vertices)</span></h2>'
            f'<ul class="census">{items}</ul></div>')
    kin = sorted(((len(spectra[mod] & spectra[o]), o)
                  for o in spectra if o != mod), reverse=True)
    kin = [(n, o) for n, o in kin if n]
    if kin:
        items = "\n".join(
            f'<li><a href="{o}.html">{html.escape(o.rsplit(".", 1)[-1])}</a>'
            f' <span class="stratum">({n} shared)</span></li>'
            for n, o in kin)
        parts.append(
            f'<div class="panel"><h2>kinship'
            f' <span class="stratum">(shared vertices, roster-wide)</span></h2>'
            f'<ul class="census">{items}</ul></div>')
    equipped = [role for role, cs in ROLES if spectra[mod] & set(cs)]
    needed = [role for role, cs in ROLES if not (spectra[mod] & set(cs))]
    ring = ('<p>from this page\'s seat, you — the visitor — are the Unknown,'
            ' and this residual is computed against exactly that: nothing.</p>')
    if equipped:
        ring += ('<p>roles this mind already equips: '
                 + " · ".join(html.escape(r) for r in equipped) + '</p>')
    if needed:
        ring += ('<p>roles a W-cycling ring through this mind still needs: '
                 + " · ".join(html.escape(r) for r in needed)
                 + ' — plus whichever of the equipped roles you carry'
                 ' yourself.</p>')
    else:
        ring += ('<p>every named role is equipped at this seat; a ring still'
                 ' needs you in yours.</p>')
    ring += ('<p class="law">bring your own mind: supply your own map (terms,'
             ' bindings, spectra — schema: minds/schema.json) and this'
             ' residual sharpens; precision is monotone in your'
             ' self-articulation. this interface is published as a hole,'
             ' typed, on purpose. the door held open is what opportunity'
             ' means.</p>')
    parts.append(f'<div class="panel"><h2>ring-residual</h2>{ring}</div>')
    return "".join(parts)


def core_panels(mod, names):
    declared = {n for n, m in names.items() if m == mod}
    rows = []
    for role, cs in ROLES:
        hits = sorted(set(cs) & declared)
        if hits:
            items = " · ".join(
                f'<a href="#{html.escape(h.rsplit(".", 1)[-1])}">'
                f'{html.escape(h.rsplit(".", 1)[-1])}</a>' for h in hits)
            rows.append(f'<p>{html.escape(role)}: {items}</p>')
    if not rows:
        return ""
    return (f'<div class="panel"><h2>ring-parts'
            f' <span class="stratum">(the existential hardware store)</span>'
            f'</h2>{"".join(rows)}</div>')


def main():
    os.makedirs(OUT, exist_ok=True)
    modules = collect()
    known = set(modules)
    names = core_names(modules)
    counter = load_counter()
    glosses = {}
    spectra = {}
    standing = {}
    openr = {}
    for _slug, data in counter.all_minds().items():
        lean = re.sub(r"[^A-Za-z0-9]", "", data["mind"])
        mod = "Foam.Minds." + lean
        glosses[mod] = {e["term"]: e.get("gloss", "")
                        for e in data["vocabulary"]}
        agg = set()
        for cites in counter.deposit_spectra(data["mind"]).values():
            agg |= set(cites)
        spectra[mod] = agg
        standing[mod] = [e["term"] for e in data["vocabulary"]
                         if e.get("status") == "unsealed" and e.get("statement")]
        openr[mod] = [e["term"] for e in data["vocabulary"]
                      if e.get("status") == "unsealed"
                      and not e.get("statement")]
    for mod, (path, stratum) in modules.items():
        panels = ""
        if stratum == "minds" and mod in spectra:
            panels = mind_panels(mod, spectra, list(glosses.get(mod, {})),
                                 standing.get(mod, []), openr.get(mod, []),
                                 names)
        elif stratum == "core":
            panels = core_panels(mod, names)
        with open(os.path.join(OUT, f"{mod}.html"), "w", encoding="utf-8") as f:
            f.write(render_module(mod, path, stratum, known,
                                  glosses.get(mod), panels))
    with open(os.path.join(OUT, "index.html"), "w", encoding="utf-8") as f:
        f.write(render_index(modules))
    print(f"[foam relief] {len(modules)} module pages + index → wiki/")


if __name__ == "__main__":
    main()
