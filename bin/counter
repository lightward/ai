#!/usr/bin/env bash
# counter: the compiler. one loop, two ears, and the readings — foam's two storeys, Room and
# Face, are its first customers, and any germ that imports either is another.
#
# the loop is the cascade: a vestibule of vacancies is re-offered round after
# round; whatever is backed seats, whatever is not is held with its darkness
# NAMED; the crawl halts drained or stuck, no third fate.
#
# the EAR is where the vacancies' name-asks are answered:
#   grow    the record's ear over a GERM — germ/<Name>.lean grows to grown/<Name>.lean, an
#           importable module; every `:= sorry` vacancy must regrow (red otherwise),
#           hand bodies regrow where a priming reaches and carry where none does;
#           citations are derived from each signature's vocabulary; the artifact is
#           never committed; the standards print at every build
#   ride    the rider's ear — turns composed live, judged one at a time by the
#           kernel; an unknown name is a want the rider may seat next turn
#   regrow  the record's ear over a hand-written trail (a measurement, not a build)
#   book    the census, the frontier, the vestibule — the book, never the prediction
#   page    the browseable artifact: site/ for foam.is
#
# conduct-as-citation (each verb names the law it mirrors):
#   a turn is an elaboration ............ Face.the_curtain_is_exact
#   an unnamed turn evaporates .......... Face.the_deferral_is_free
#   a named turn persists ............... Face.the_backed_are_seated
#   a refusal is held, darkness named ... Face.the_unbacked_wait,
#                                         Face.the_held_name_their_darkness
#   the round seats the ready ........... chrysalis:chrysalis/chrysalis/Seed.lean the_ready_seat_in_one_sweep
#   drained or stuck, nothing else ...... chrysalis:chrysalis/chrysalis/Seed.lean no_third_fate
#   the session only grows .............. Face.the_park_resumes
#   a stage may ground a stage .......... Face.a_stage_may_ground_a_stage (a germ that imports a germ)
#   the grown trunk is its own image .... chrysalis:chrysalis/chrysalis/Seed.lean the_fixed_are_the_landed
#
# usage:
#   bin/counter grow [germ/Name.lean] [--settle] [--check]     (default germ/Face.lean)
#     --settle  rewrite the germ minimal: derived order, every regrowable hand body a
#               vacancy, a route kept only where load-bearing (a stored derivable is drift)
#     --check   red iff the germ is not already its own settle
#   bin/counter probe germ/Name.lean theorem_name
#     the rider's ear pointed at one line of a germ: every priming, against the grown module, with
#     the cites that vacancy can reach; the gate's sentence for each hold. --keep leaves trials
#     under regrowth/trials/ (grow and regrow honor it too)
#   bin/counter ride [session.lean]
#   bin/counter book [trail.lean | vestibule.held ...]
#   bin/counter page
#   bin/counter regrow [trail.lean | vestibule.held ...] [-o out.lean] [--settle] [--check]
#                      [--primings primings.lean]
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

usage() {
  sed -n '2,48p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

# ---------------------------------------------------------------- the rider's ear

ride_ear() {

mkdir -p regrowth
SESSION="${1:-regrowth/ride.lean}"
HELD="${SESSION%.lean}.held"

if ! lake build Face >/dev/null 2>&1; then
  echo "the gate cannot open: Face does not build" >&2
  exit 1
fi

if [ ! -f "$SESSION" ]; then
  printf 'import Face\nopen Room Face\nset_option autoImplicit false\nuniverse u v w\n' > "$SESSION"
fi

named_in() {
  printf '%s\n' "$1" | grep -E '^(theorem|def|inductive|structure|abbrev) ' \
    | sed -E 's/^[a-z]+ +([^ :({.]+).*/\1/'
}

spells() {
  grep -E '^(theorem|def|inductive|structure|abbrev) ' "$SESSION" \
    | sed -E 's/^[a-z]+ +([^ :({.]+).*/\1/'
}

held_count() {
  if [ -f "$HELD" ]; then grep -c '^-- held' "$HELD" 2>/dev/null || true; else echo 0; fi
}

status_line() {
  printf '(spells %s | held %s)\n' "$(spells | wc -l | tr -d ' ')" "$(held_count)"
}

try_turn() {
  local turn="$1" quiet="${2:-}" stem tmp out names missing
  stem="$(mktemp /tmp/crawl.XXXXXX)"
  tmp="${stem}.lean"
  cat "$SESSION" > "$tmp"
  printf '\n%s\n' "$turn" >> "$tmp"
  if out="$(lake env lean "$tmp" 2>&1)"; then
    if printf '%s\n' "$out" | grep -q "declaration uses .sorry"; then
      [ -z "$quiet" ] && printf '%s\n' "$out"
      { printf -- '-- held (waiting on: an honest proof — sorry refused)\n'
        printf '%s\n' "$turn"
        printf -- '-- end\n'; } >> "$HELD"
      echo "held at the vestibule (sorry refused — the gate does not accept trust-me)"
      rm -f "$tmp" "$stem"
      return 1
    fi
    LAST_MARKER=""
    names="$(named_in "$turn" | tr '\n' ' ')"
    if [ -n "${names// /}" ]; then
      { printf '\n%s\n' "$turn"; } >> "$SESSION"
      echo "seated: ${names}"
    else
      echo "evaporated (unnamed; the deferral is free)"
    fi
    [ -n "$out" ] && printf '%s\n' "$out"
    rm -f "$tmp" "$stem"
    return 0
  else
    [ -z "$quiet" ] && printf '%s\n' "$out"
    missing="$(printf '%s\n' "$out" \
      | grep -oiE "unknown (identifier|constant) \`[^\`]+\`" \
      | sed -E 's/.*`([^`]+)`.*/\1/' | sort -u | tr '\n' ' ')"
    unis="$(printf '%s\n' "$out" \
      | grep -oE 'unknown universe level \`[^\`]+\`' \
      | sed -E 's/.*\`([^\`]+)\`.*/\1/' | sort -u | tr '\n' ' ')"
    if [ -n "${missing// /}" ]; then
      marker="waiting on: ${missing}"
    elif printf '%s\n' "$out" | grep -qiE "universe.*has already been declared|'[a-z]' has already been declared"; then
      marker="this turn redeclares a universe already present - re-offer it without the universe line"
    elif [ -n "${unis// /}" ]; then
      marker="waiting on: universe ${unis}- declare it in a turn that seats (new sessions carry u v w from birth)"
    else
      scar="$(printf '%s\n' "$out" \
        | grep -oE "\`?'?[A-Za-z0-9_.]+'?\`? has already been declared" \
        | head -1 | sed -E "s/[\`']*([A-Za-z0-9_.]+)[\`']* has already.*/\1/")"
      if [ -n "$scar" ]; then
        marker="a scar: '${scar}' already seated by another turn; this one wants nothing"
      else
        marker="waiting on: unnamed darkness — read the block below with :held"
      fi
    fi
    LAST_MARKER="$marker"
    { printf -- '-- held (%s)\n' "$marker"
      printf '%s\n' "$turn"
      printf -- '-- end\n'; } >> "$HELD"
    echo "held at the vestibule (${marker})"
    rm -f "$tmp" "$stem"
    return 1
  fi
}

do_sweep() {
  [ -f "$HELD" ] || { echo "vestibule empty"; return; }
  local old="${HELD}.sweeping" block="" inblock=0 seated=0 kept=0 report="" nm=""
  mv "$HELD" "$old"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "-- held"*) inblock=1; block="" ;;
      "-- end")
        inblock=0
        nm="$(named_in "$block" | head -1)"
        if try_turn "$block" quiet >/dev/null 2>&1; then
          seated=$((seated+1))
          report+="  seated from the vestibule: ${nm:-unnamed turn}"$'\n'
        else
          kept=$((kept+1))
          report+="  still held: ${nm:-unnamed turn} (${LAST_MARKER})"$'\n'
        fi
        ;;
      *) [ "$inblock" = 1 ] && block+="$line"$'\n' ;;
    esac
  done < "$old"
  rm -f "$old"
  echo "sweep: ${seated} seated, ${kept} still held"
  printf '%s' "$report"
  status_line
}

echo "counter, the rider's ear (session: ${SESSION})"
echo "compose freely; :go offers your turn to the gate; :q leaves (exit is free)"
echo "run :go to move forward (:help lists the verbs)"

buf=""
while true; do
  if [ -t 0 ]; then
    IFS= read -r -e line || break
  else
    IFS= read -r line || break
  fi
  if [ -n "$buf" ] && [ "${line:0:1}" != ":" ]; then
    buf+="$line"$'\n'
    continue
  fi
  case "$line" in
    :q|:quit) break ;;
    :help)
      cat <<'HELP'
:go      offer the composed turn to the gate (empty turn: just the statusline)
:paste   raw capture until a line ':end' (for large pastes; skips readline)
:back    drop the last composed line
:show    read the turn you're composing
:edit    open the composing buffer in $EDITOR
:spells  list the session's named declarations
:held    show the vestibule, full blocks
:sweep   re-offer every held turn (one round of the cascade)
:status  the statusline
:q       leave; the session persists (exit is free)
anything else accumulates into your turn; blank lines are yours to mean with
HELP
      continue ;;
    :paste)
      echo "paste mode: end with a line containing only :end"
      while IFS= read -r pline; do
        [ "$pline" = ":end" ] && break
        buf+="$pline"$'\n'
      done
      echo "captured; :show to read, :go to offer"
      continue ;;
    :back)
      if [ -n "$buf" ]; then
        dropped="$(printf '%s' "$buf" | tail -1)"
        buf="$(printf '%s' "$buf" | sed '$d')"
        [ -n "$buf" ] && buf+=$'\n'
        echo "dropped: ${dropped}"
      else
        echo "nothing composed"
      fi
      continue ;;
    :show)
      if [ -n "${buf//[[:space:]]/}" ]; then printf '%s' "$buf"; else echo "composing: (empty)"; fi
      continue ;;
    :edit)
      if [ -t 0 ]; then
        etmp="$(mktemp /tmp/crawl-edit.XXXXXX)"
        printf '%s' "$buf" > "$etmp"
        "${EDITOR:-vi}" "$etmp" </dev/tty >/dev/tty 2>&1
        buf="$(cat "$etmp")"
        [ -n "$buf" ] && buf+=$'\n'
        rm -f "$etmp"
        echo "buffer updated"
      else
        echo ":edit wants a terminal"
      fi
      continue ;;
    :go)
      if [ -n "${buf//[[:space:]]/}" ]; then
        try_turn "$buf" || true
      fi
      buf=""
      status_line
      continue ;;
  esac
  if [ -z "${buf//[[:space:]]/}" ]; then
    case "$line" in
      :spells)
        if [ -n "$(spells | head -1)" ]; then spells; else echo "spellbook empty"; fi
        continue ;;
      :held)
        if [ -f "$HELD" ] && grep -q '^-- held' "$HELD" 2>/dev/null; then
          cat "$HELD"
        else
          echo "vestibule empty"
        fi
        continue ;;
      :sweep) do_sweep; continue ;;
      :status) status_line; continue ;;
    esac
  fi
  buf+="$line"$'\n'
done

if [ -n "${buf//[[:space:]]/}" ]; then
  try_turn "$buf" || true
  status_line
fi

echo "the record kept: ${SESSION}"
}

# ---------------------------------------------------------------- the record's ear

regrow_ear() {
  local inputs=() out="" settle=0 check=0 primings="" keep=0 probe=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -o) out="$2"; shift 2 ;;
      --primings) primings="$2"; shift 2 ;;
      --keep) keep=1; shift ;;
      --probe) probe="$2"; shift 2 ;;
      --settle) settle=1; shift ;;
      --check) check=1; shift ;;
      -h|--help) usage ;;
      *) inputs+=("$1"); shift ;;
    esac
  done
  if [ ${#inputs[@]} -eq 0 ]; then
    if [ -n "${CRAWL_GERM:-}" ]; then inputs=(germ/Face.lean); else inputs=(grown/Face.lean); fi
  fi
  local first="${inputs[0]}"
  local name; name="$(basename "${first%.lean}")"
  if [ -z "$out" ]; then
    if [ -n "${CRAWL_GERM:-}" ]; then mkdir -p grown; out="grown/${name}.lean"
    elif [ "$settle" = 1 ]; then out="$first"
    else mkdir -p regrowth; out="regrowth/${name}.lean"; fi
  fi
  if [ -n "${CRAWL_GERM:-}" ]; then
    # a germ that imports a germ: grow and build what it stands on first (a stage may ground a stage)
    local dep
    for dep in $(grep -E '^import ' "$first" | awk '{print $2}'); do
      if [ -f "germ/${dep}.lean" ]; then
        [ -f "grown/${dep}.lean" ] || bin/counter grow "germ/${dep}.lean" >/dev/null || { echo "the gate cannot open: ${dep} does not grow"; exit 1; }
        lake build "$dep" >/dev/null 2>&1 || { echo "the gate cannot open: ${dep} does not build"; exit 1; }
      fi
    done
  fi
  local held="${out%.lean}.held"
  if [ -n "${CRAWL_GERM:-}" ]; then mkdir -p regrowth; held="regrowth/$(basename "${out%.lean}").held"; fi

  local report=""
  if [ -n "${CRAWL_GERM:-}" ]; then mkdir -p regrowth; report="regrowth/$(basename "${out%.lean}").report"; fi
  if [ "$keep" = 1 ]; then mkdir -p regrowth/trials; export CRAWL_KEEP=1; export TMPDIR="$ROOT/regrowth/trials"; fi
  CRAWL_OUT="$out" CRAWL_HELD="$held" CRAWL_PRIMINGS="$primings" CRAWL_SETTLE="$settle" CRAWL_CHECK="$check" CRAWL_PROBE="$probe" python3 - "${inputs[@]}" <<'EOF' | { if [ -n "$report" ]; then tee "$report"; else cat; fi; }
import os, re, subprocess, sys, tempfile

out_path, held_path = os.environ['CRAWL_OUT'], os.environ['CRAWL_HELD']
primings_path = os.environ.get('CRAWL_PRIMINGS', '')
germ_mode = bool(os.environ.get('CRAWL_GERM'))
settle_mode = os.environ.get('CRAWL_SETTLE') == '1'
check_mode = os.environ.get('CRAWL_CHECK') == '1'
germ_path = sys.argv[1]
probe_name = os.environ.get('CRAWL_PROBE', '')
DECL = re.compile(r'^(theorem|def|structure|inductive|abbrev) (\w+)', re.M)

MARKER = re.compile(r'^-- held \(waiting on: ([^)]*)\)\n', re.M)
marker_needs = {}

def blocks_of(src):
    spans = [(m.start(), m.group(1), m.group(2)) for m in DECL.finditer(src)]
    if not spans:
        return '', [], ''
    header = src[:spans[0][0]]
    tail_m = re.search(r'\n(end \w+)\s*$', src)
    body_end = tail_m.start() + 1 if tail_m else len(src)
    footer = tail_m.group(1) if tail_m else ''
    out = []
    for i, (start, kind, name) in enumerate(spans):
        end = spans[i + 1][0] if i + 1 < len(spans) else body_end
        out.append([kind, name, src[start:end]])
    # a vacancy's marker sits at the tail of the block before it; peel it onto its own block
    for i in range(len(out) - 1):
        ms = list(MARKER.finditer(out[i][2]))
        if ms and ms[-1].end() >= len(out[i][2].rstrip('\n')):
            marker_needs[out[i + 1][1]] = ms[-1].group(1).split()
            out[i][2] = out[i][2][:ms[-1].start()]
    ms = list(MARKER.finditer(header))
    if out and ms and ms[-1].end() >= len(header.rstrip('\n')):
        marker_needs[out[0][1]] = ms[-1].group(1).split()
        header = header[:ms[-1].start()]
    for b in out:
        b[2] = re.sub(r'^-- end\n', '', b[2], flags=re.M)
    return header, [tuple(b) for b in out], footer

def blocks_of_held(src):
    out, block, inblock = [], [], False
    for line in src.splitlines():
        if line.startswith('-- held'):
            inblock, block = True, []
        elif line == '-- end':
            inblock = False
            text = '\n'.join(block).strip('\n') + '\n'
            m = DECL.search(text)
            out.append((m.group(1) if m else 'theorem', m.group(2) if m else '?', text))
        elif inblock:
            block.append(line)
    return out

header, footer, blocks, held_blocks = None, '', [], []
for path in sys.argv[1:]:
    src = open(path).read()
    if path.endswith('.held'):
        held_blocks += blocks_of_held(src)
    else:
        h, b, f = blocks_of(src)
        if header is None:
            header, footer = h, f
        blocks += b
header = header or ''
NS_NAME = (re.search(r'^namespace (\w+)', header, re.M) or re.search(r'^namespace (\w+)', 'namespace Face', re.M)).group(1)
IMPORTS = [m for m in re.findall(r'^import (\S+)', header, re.M) if m != 'Init']
SCOPE = [NS_NAME, ','.join(IMPORTS)]
seated_names = set(n for _, n, _ in blocks)
for k, n, b in held_blocks:
    if n in seated_names:
        print(f'a scar: {n} already seated in the trail; the held block wants nothing')
    else:
        blocks.append((k, n, b)); seated_names.add(n)

carriers = [(k, n, b) for k, n, b in blocks if k != 'theorem']
theorems = [(k, n, b) for k, n, b in blocks if k == 'theorem']
tnames = set(n for _, n, _ in theorems)
order_index = {n: i for i, (_, n, _) in enumerate(theorems)}

def strip_receipts(b):
    return '\n'.join(l for l in b.splitlines()
                     if '#print axioms' not in l and '#guard_msgs' not in l)

needs = {}
for _, n, b in theorems:
    body = strip_receipts(b)
    needs[n] = set(t for t in tnames if t != n and re.search(r'\b' + re.escape(t) + r'\b', body))
    needs[n] |= set(marker_needs.get(n, [])) & tnames

# the exact lattice: ask the elaborator which theorems each proof term actually uses
# (bin/judge.lean needs); regex stands as the fallback for any block the whole-trail
# elaboration could not seat (a vacancy citing a name not yet in the trail)
tf = tempfile.NamedTemporaryFile('w', suffix='.lean', prefix='crawl-needs-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
tf.write('\n'.join([header.rstrip('\n'), ''] + [b.rstrip('\n') + '\n' for _, _, b in blocks] + ([footer] if footer else [])) + '\n')
tf.close()
res = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', 'needs', tf.name] + SCOPE, capture_output=True, text=True)
os.unlink(tf.name)
exact = 0
for l in res.stdout.splitlines():
    n, sep, deps = l.partition(' <- ')
    if sep and n in needs:
        needs[n] = (set(deps.split()) & tnames - {n}) | (set(marker_needs.get(n, [])) & tnames)
        exact += 1
print(f'the lattice: {exact} need-lists from the elaborator, {len(needs) - exact} from the trail text')

seated, storey, rounds = set(), {}, []
pending = [n for _, n, _ in theorems]
r = 0
while pending:
    r += 1
    ready = [n for n in pending if needs[n] <= seated]
    if not ready:
        by_name = {n: b for _, n, b in theorems}
        with open(held_path, 'w') as f:
            for n in pending:
                want = ' '.join(sorted(needs[n] - seated))
                f.write(f'-- held (waiting on: {want})\n{by_name[n].rstrip()}\n-- end\n')
        print(f'STUCK at round {r}: {len(pending)} held, darkness named in {held_path}')
        for n in pending[:10]:
            print(f'  {n}: waiting on {" ".join(sorted(needs[n] - seated))}')
        sys.exit(1)
    for n in ready:
        seated.add(n); storey[n] = r
    rounds.append(len(ready))
    pending = [n for n in pending if n not in seated]

by_name = {n: b for _, n, b in theorems}
order = sorted(theorems, key=lambda t: (storey[t[1]], order_index[t[1]]))

print(f'the primer: {len(carriers)} carriers')
print(f'the vacancies: {len(theorems)} theorems, one egg each')
if not germ_mode:
    print(f'the drain: {len(rounds)} storeys — ' + ' '.join(str(c) for c in rounds))
    free = [n for n in storey if storey[n] == 1]
    deep = max(storey.items(), key=lambda kv: kv[1]) if storey else ('—', 0)
    print(f'the free layer: {len(free)} theorems need only the primer')
    print(f'the deepest seat: {deep[0]} at storey {deep[1]}')

prefix = [header.rstrip('\n'), '']
for _, _, b in carriers:
    prefix.append(b.rstrip('\n')); prefix.append('')

seated_text = {}

if primings_path:
    # ---- tier two: regrow the proof bodies from the ordered primings
    primings, cur, budget, reach = [], None, None, 12
    for line in open(primings_path).read().splitlines():
        mb = re.match(r'-- budget: (\d+)$', line)
        if mb:
            budget = int(mb.group(1)); continue
        mr = re.match(r'-- reach: (\d+)$', line)
        if mr:
            reach = int(mr.group(1)); continue
        m = re.match(r'-- priming: (.+)$', line)
        if m:
            cur = [m.group(1).strip(), []]; primings.append(cur)
        elif cur is not None and not line.startswith('--'):
            cur[1].append(line)
    primings = [(nm, '\n'.join(body).strip('\n')) for nm, body in primings if ''.join(body).strip()]

    def split_block(b):
        rt = b.rfind('\n/-- info:')
        receipts = b[rt:] if rt != -1 else ''
        core = b[:rt] if rt != -1 else b
        a, c = core.find(':='), core.find('\n  | ')
        cut = min(x for x in (a, c, len(core)) if x != -1)
        return core[:cut].rstrip(), receipts.strip('\n')

    def ordered_needs(n):
        if n in marker_needs:
            return [t for t in marker_needs[n] if t in tnames and t != n]
        body = strip_receipts(by_name[n])
        found = []
        for t in tnames:
            if t == n: continue
            m = re.search(r'\b' + re.escape(t) + r'\b', body)
            if m: found.append((m.start(), t))
        return [t for _, t in sorted(found)]

    def binder_names(n):
        # the statement's HYPOTHESES (not its data): binders whose type is an equation, an iff, a
        # membership, a negation, a ∀, or an application of a lowercase (Prop-valued) carrier —
        # alike, unheard, carries. data binders (F : Face, m : S → S) are never applicables.
        stmt, _ = split_block(by_name[n])
        out = []
        for names, ty in re.findall(r'[({]([^:(){}]+?)\s*:\s*((?:[^(){}]|\([^()]*\))*?)[)}]', stmt):
            t = ty.strip()
            head = re.match(r'([A-Za-z_][A-Za-z0-9_.]*)', t)
            is_prop = (re.search(r'(?<![<>≠!])=(?!>)|↔|∈|≠|¬|∀', t) is not None
                       or (head and head.group(1) in cnames and head.group(1)[0].islower()))
            if is_prop:
                out += [x for x in names.split() if re.match(r"[A-Za-z_][A-Za-z0-9_₀-₉']*$", x)]
        return out

    def cite_macro(ns, n=None):
        # a citation — or one of the statement's own hypotheses — with its side goals closed by
        # assumption, rfl, or ONE more citation/hypothesis from the same list (a lemma that takes
        # a lemma as an argument — hrefl, a helper — or a side goal that is a hypothesis applied)
        hyps = binder_names(n) if n else []
        names = list(ns) + [h for h in hyps if h not in ns]
        if not names:
            return 'fail'
        # every side alternative must CLOSE or fail: a bare `apply` can succeed leaving goals,
        # `first` counts that as success, and the outer alternative commits with work undone
        CLOSE = '(first | assumption | rfl)'
        def hyp_forms(m):
            # a hypothesis whose type is a def (unheard, carries) hides its ∀ from `apply`;
            # `exact h _` elaborates the application and unfolds as needed
            return f'| (apply {m} <;> {CLOSE}) | (exact {m} _)'
        def side(t):
            others = ' '.join((hyp_forms(m) if m in hyps else f'| (apply {m} <;> {CLOSE})') for m in names if m != t)
            return f'(first | assumption | rfl {others})' if others else CLOSE
        heads = ' '.join((f'| (apply {t} <;> {side(t)})' if t not in hyps else f'| (apply {t} <;> {side(t)}) | (exact {t} _)') for t in names)
        return 'first ' + heads

    cnames = [n for _, n, _ in carriers]
    defs_of = {}
    tf2 = tempfile.NamedTemporaryFile('w', suffix='.lean', prefix='crawl-cites-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
    tf2.write('\n'.join([header.rstrip('\n'), ''] + [b.rstrip('\n') + '\n' for _, _, b in blocks] + ([footer] if footer else [])) + '\n')
    tf2.close()
    res2 = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', 'cites', tf2.name] + SCOPE, capture_output=True, text=True)
    os.unlink(tf2.name)
    carrier_deps = {}
    for l in res2.stdout.splitlines():
        parts = l.split(' <- ')
        if len(parts) == 2 and parts[0].startswith('theorem '):
            defs_of[parts[0].split()[1]] = [d for d in parts[1].split() if d in cnames or (d.startswith(NS_NAME + '.') is False and '.' in d)]
        elif len(parts) == 2 and parts[0].startswith('carrier '):
            # a carrier's vocabulary: every owned name it unfolds to — local carriers AND the
            # imported ones (a customer's `offer` unfolds to Foam.welcome; the key must know)
            carrier_deps[parts[0].split()[1]] = parts[1].split()

    def defs_macro(n):
        ds = defs_of.get(n)
        if ds is None:
            stmt, _ = split_block(by_name[n])
            ds = [c for c in cnames if re.search(r'\b' + re.escape(c) + r'\b', stmt)]
        return ', '.join(ds) if ds else ''

    def hyps_of(n):
        # the statement's own equation-shaped hypotheses, by binder name
        stmt, _ = split_block(by_name[n])
        out = []
        for names, ty in re.findall(r'\(([^:()]+?)\s*:\s*((?:[^()]|\([^()]*\))*?)\)', stmt):
            if re.search(r'(?<![<>≠!])=(?!>)|↔', ty):
                out += [x for x in names.split() if re.match(r'[A-Za-z_][A-Za-z0-9_₀-₉\']*$', x)]
        return out

    def rws_macro(ns, n=None):
        names = (hyps_of(n) if n else []) + list(ns)
        return '; '.join(f'(try rw [{t}])' for t in names) if names else 'skip'

    def rws_alternatives(ns, n, closers):
        # each rewrite as an ATOMIC alternative with its own closers: a rewrite that succeeds in
        # the wrong place fails and backtracks instead of poisoning the moves after it
        # rewriting is the tightening move: the hint first, then only the few cites most akin
        names = (hyps_of(n) if n else []) + list(ns)[:4]
        return ' '.join(f'| (rw [{t}]; {closers})' for t in names)

    def chains_alternatives(ns, n, closers):
        # the term chain: a cited law or hypothesis, applied at some arity, composed by `.trans`
        # with one more close — `(c2 _ _).trans (c1 _ _)` — each alternative atomic, with its own
        # closers; the hypotheses first (a chain usually starts from the statement's own law)
        hyps = binder_names(n) if n else []
        names = hyps + [t for t in list(ns)[:6] if t not in hyps]
        out = []
        for t in names:
            for k in range(4):
                app = f'({t}{" _" * k})' if k else t
                out.append(f'| exact {app}.trans (by {closers})')
                out.append(f'| exact {app}.symm.trans (by {closers})')
        return ' '.join(out)

    def cite_compact(ns, n=None):
        # the one-deep cite over the few most akin — what a rewrite alternative may carry
        hyps = binder_names(n) if n else []
        names = list(ns)[:4] + [h for h in hyps if h not in ns]
        if not names:
            return 'fail'
        return 'first ' + ' '.join((f'| (apply {t} <;> (first | assumption | rfl))' if t not in hyps else f'| (apply {t} <;> (first | assumption | rfl)) | (exact {t} _)') for t in names)

    def instantiate(body, ns, n=None):
        # the rewrite fan first, with compact closers inside it; then the full cite for the rest
        def rws_sub(m):
            closers = m.group(1).strip().replace('{cite}', cite_compact(ns, n))
            return rws_alternatives(ns, n, closers)
        out = re.sub(r'\{rws\|([^{}]*(?:\{cite\}[^{}]*)*)\}', rws_sub, body)
        def chains_sub(m):
            closers = m.group(1).strip().replace('{cite}', cite_compact(ns, n))
            return chains_alternatives(ns, n, closers)
        out = re.sub(r'\{chains\|([^{}]*(?:\{cite\}[^{}]*)*)\}', chains_sub, out)
        out = (out.replace('{cite}', cite_macro(ns, n))
                  .replace('{rws}', rws_macro(ns, n))
                  .replace('{defs}', defs_macro(n) if n else ''))
        return out

    tally = {nm: 0 for nm, _ in primings}
    carried = []
    ns_m = re.search(r'^namespace (\w+)', header, re.M)
    NS = ns_m.group(1) + '.' if ns_m else ''

    def receipt_for(n):
        return f"/-- info: '{NS}{n}' does not depend on any axioms -/\n#guard_msgs in #print axioms {n}"

    def hand_with_receipt(n):
        b = by_name[n].rstrip('\n')
        rt = b.rfind('\n/-- info:')
        core = (b[:rt] if rt != -1 else b).rstrip('\n')
        return core + '\n\n' + receipt_for(n)

    def candidate_text(n, k, cites=None):
        stmt, _ = split_block(by_name[n])
        body = instantiate(primings[k][1], ordered_needs(n) if cites is None else cites, n)
        body = '\n'.join(('  ' + l if l else l) for l in body.splitlines())
        fuel = f'set_option maxHeartbeats {budget} in\n' if budget else ''
        return fuel + stmt.replace(f'theorem {n}', f'theorem {n}__p{k}', 1) + ' :=\n' + body

    def line_count(xs):
        return sum(x.count('\n') + 1 for x in xs)

    def judge(prefix_lines, cands):
        """cands: list of (n, k). every candidate is elaborated in Lean against the
        prefix — once loaded, never re-elaborated — through bin/judge.lean, whose
        message log is complete (the CLI's own report caps at ~100 errors; the
        in-process log does not). returns the set of (n, k) that FAILED."""
        if not cands:
            return set()
        pre = tempfile.NamedTemporaryFile('w', suffix='.lean', prefix='crawl-prefix-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
        pre.write('\n'.join(prefix_lines) + '\n'); pre.close()
        cf = tempfile.NamedTemporaryFile('w', suffix='.txt', prefix='crawl-cands-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
        cf.write('\n-- candidate\n'.join(candidate_text(*c) for c in cands) + '\n'); cf.close()
        import time
        t0 = time.time()
        res = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', pre.name, cf.name],
                             capture_output=True, text=True)
        if os.environ.get('CRAWL_DEBUG') or os.environ.get('CRAWL_KEEP'):
            print(f'[trial] {pre.name} {cf.name}: {len(cands)} candidates, exit {res.returncode}, {time.time() - t0:.1f}s')
        else:
            os.unlink(pre.name); os.unlink(cf.name)
        verdicts = {}
        for l in res.stdout.splitlines():
            m = re.match(r'(\d+) (seated|held)$', l)
            if m:
                verdicts[int(m.group(1))] = m.group(2)
        if res.returncode != 0 or len(verdicts) != len(cands):
            raise SystemExit('crawl: the judge did not return a verdict for every candidate:\n'
                             + (res.stdout + res.stderr)[-2000:])
        return set(i for i in range(len(cands)) if verdicts[i] == 'held')

    kept_hint = {}
    if germ_mode:
        # ---- the germ: the cascade as a fixed-point search. a vacancy's citations are
        # DERIVED from its signature's vocabulary (the type's constants, one unfolding
        # through the carriers it names) and ranked by shared vocabulary, then by how
        # recently the candidate seated, then by trail recency — the primer as an
        # ordering, not a stored route. a hint (marker) is tried too, and kept by the
        # settle only if the vacancy does not seat without it.
        kf = tempfile.NamedTemporaryFile('w', suffix='.lean', prefix='crawl-keys-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
        kf.write('\n'.join([header.rstrip('\n'), ''] + [b.rstrip('\n') + '\n' for _, _, b in blocks] + ([footer] if footer else [])) + '\n')
        kf.close()
        resk = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', 'keys', kf.name] + SCOPE, capture_output=True, text=True)
        os.unlink(kf.name)
        keys, pool = {}, []   # pool: the imported trunk's theorems, seated before round one
        for l in resk.stdout.splitlines():
            n, sep, ks = l.partition(' <- ')
            if not sep: continue
            if n.startswith('import '):
                n = n.split()[1]
                keys[n] = set(ks.split()) - {n}
                pool.append(n)
            elif n in by_name:
                k = set(ks.split())
                for c in list(k):
                    k |= set(carrier_deps.get(c, []))
                keys[n] = k - {n}
        for _, n, _ in theorems:
            keys.setdefault(n, set())
        imported_theorems = set(pool)
        # rarity: a constant shared by nearly every statement (Eq) says almost nothing; one
        # shared by a handful (Or) says a lot — the record's own statistics as the ordering
        import math
        df = {}
        for n in list(pool) + [n for _, n, _ in theorems]:
            for c in keys.get(n, ()):
                df[c] = df.get(c, 0) + 1
        N = len(pool) + len(theorems)
        def weight(c):
            return math.log((N + 1) / (df.get(c, 0) + 1))
        def affinity(t, n):
            # shared rarity, normalized by the candidate's own vocabulary: a tight lemma that
            # shares most of its words outranks a crown that shares a few of its many
            shared = sum(weight(c) for c in keys[t] & keys[n])
            own = sum(weight(c) for c in keys[t]) or 1.0
            return shared / math.sqrt(own)
        is_vac = {n: bool(re.search(r':=\s*sorry\s*$', strip_receipts(by_name[n]).strip())) for _, n, _ in theorems}
        trail_index = {n: i for i, (_, n, _) in enumerate(theorems)}
        entry = {n: t for t in theorems for n in [t[1]]}
        seated_order, seated_round, seated_set = [], {}, set()
        pending_hand = [n for _, n, _ in theorems if not is_vac[n]]
        pending_vac = [n for _, n, _ in theorems if is_vac[n]]
        rounds, tried = [], 0
        P = len(primings)

        by_bare = {}
        for t in pool:
            by_bare.setdefault(t.split('.')[-1], t)

        def resolve_hint(n):
            # a route may name a theorem that has since moved into an imported module: match bare
            # names against the pool and keep the qualified form
            out = []
            for h in marker_needs.get(n, []):
                bare = h.split('.')[-1]
                if h in tnames or h in imported_theorems: out.append(h)
                elif h in by_bare: out.append(by_bare[h])
                elif bare in tnames: out.append(bare)            # a qualified route whose prefix moved
                elif bare in by_bare: out.append(by_bare[bare])
            return out

        def derived_cites_all(n):
            cs = [t for t in pool + seated_order if t != n and (keys[t] & keys[n] or t in used_hint(n))]
            cs.sort(key=lambda t: (-affinity(t, n), -seated_round.get(t, 0), -trail_index.get(t, -1)))
            return cs

        def used_hint(n):
            return set(marker_needs.get(n, [])) | set(ordered_needs(n))

        def derived_cites(n):
            return [t for t in derived_cites_all(n) if keys[t] & keys[n]][:reach]

        def seat_regrown(n, k, cites):
            pname, pbody = primings[k]
            stmt, _ = split_block(by_name[n])
            body = instantiate(pbody, cites, n)
            body = '\n'.join(('  ' + l if l else l) for l in body.splitlines())
            seated_text[n] = stmt + ' :=\n' + body + '\n\n' + receipt_for(n)
            tally[pname] += 1
            return pname

        if probe_name:
            # the rider's ear pointed at one line of the germ: every priming, against the grown
            # module, with the cites this vacancy can reach — and the gate's sentence for each hold
            if probe_name not in by_name:
                raise SystemExit(f'probe: no theorem named {probe_name} in {germ_path}')
            grown_path = os.path.join('grown', os.path.basename(germ_path))
            if not os.path.exists(grown_path):
                raise SystemExit(f'probe: {grown_path} is not grown yet — bin/counter grow {germ_path} first')
            grown_src = open(grown_path).read()
            grown_lines = [re.sub(r'\nend \w+\s*$', '\n', grown_src)]
            for _, n, _ in theorems:
                if n != probe_name:
                    seated_order.append(n); seated_set.add(n); seated_round[n] = 1
            n = probe_name
            der = derived_cites(n)
            hint = resolve_hint(n)
            print(f'probe: {n}')
            print(f'  vocabulary: {" ".join(sorted(keys[n])) or "—"}')
            print(f'  cites in reach ({reach}): {" ".join(der) or "—"}')
            if hint: print(f'  hint: {" ".join(hint)}')
            cands = [(n, k, der) for k in range(P)]
            if hint:
                cands += [(n, k, hint + [d for d in der if d not in hint]) for k in range(P)]
            pre = tempfile.NamedTemporaryFile('w', suffix='.lean', prefix='probe-prefix-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
            pre.write('\n'.join(grown_lines) + '\n'); pre.close()
            cf = tempfile.NamedTemporaryFile('w', suffix='.txt', prefix='probe-cands-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
            cf.write('\n-- candidate\n'.join(candidate_text(*c) for c in cands) + '\n'); cf.close()
            res = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', pre.name, cf.name, 'vv'], capture_output=True, text=True)
            if not os.environ.get('CRAWL_KEEP'):
                os.unlink(pre.name); os.unlink(cf.name)
            lines = res.stdout.splitlines()
            i = 0
            while i < len(lines):
                m = re.match(r'(\d+) (seated|held)( \d+ms)?$', lines[i])
                if m:
                    ci = int(m.group(1)); k = ci % P; variant = 'hinted' if ci >= P else 'derived'
                    print(f'  {primings[k][0]:22s} {variant:8s} {m.group(2)}{m.group(3) or ""}')
                    i += 1
                    while i < len(lines) and lines[i].startswith('    '):
                        print(f'      {lines[i].strip()}'); i += 1
                else:
                    i += 1
            if res.returncode != 0:
                print(res.stderr[-1500:])
            sys.exit(0)

        r = 0
        while pending_hand or pending_vac:
            r += 1
            ready_hand = [n for n in pending_hand if needs[n] <= seated_set]
            if not ready_hand and not pending_vac:
                print(f'STUCK at round {r}: {len(pending_hand)} hand bodies wait on names that never seat:')
                for n in pending_hand[:10]:
                    print(f'  {n}: waiting on {" ".join(sorted(needs[n] - seated_set))}')
                sys.exit(1)
            prefix_lines = list(prefix)
            for n in seated_order:
                prefix_lines.append(seated_text[n]); prefix_lines.append('')
            cands = []
            for n in ready_hand:
                der = derived_cites(n); body_cites = ordered_needs(n)
                for k in range(P): cands.append((n, k, der, 'derived'))
                if body_cites and body_cites != der:
                    for k in range(P): cands.append((n, k, body_cites, 'hinted'))
            for n in pending_vac:
                der = derived_cites(n)
                for k in range(P): cands.append((n, k, der, 'derived'))
                hint = resolve_hint(n)
                if hint and all(h in seated_set or h in imported_theorems for h in hint):
                    hinted = hint + [d for d in der if d not in hint]
                    for k in range(P): cands.append((n, k, hinted, 'hinted'))
            tried += len(cands)
            failed = judge(prefix_lines, [(n, k, cites) for (n, k, cites, _) in cands])
            best = {}
            for i, (n, k, cites, tag) in enumerate(cands):
                if i in failed: continue
                rank = (0 if tag == 'derived' else 1, k)
                if n not in best or rank < best[n][0]:
                    best[n] = (rank, k, cites, tag)
            per_round = {nm: 0 for nm, _ in primings}
            seated_now, carried_now = [], 0
            for n in ready_hand:
                if n in best:
                    _, k, cites, tag = best[n]
                    per_round[seat_regrown(n, k, cites)] += 1
                    kept_hint[n] = ordered_needs(n) if tag == 'hinted' else []
                else:
                    seated_text[n] = hand_with_receipt(n); carried.append(n); carried_now += 1
                seated_now.append(n)
            for n in pending_vac:
                if n in best:
                    _, k, cites, tag = best[n]
                    per_round[seat_regrown(n, k, cites)] += 1
                    kept_hint[n] = resolve_hint(n) if tag == 'hinted' else []
                    seated_now.append(n)
            seated_now.sort(key=lambda n: trail_index[n])
            for n in seated_now:
                seated_set.add(n); seated_round[n] = r; seated_order.append(n)
            pending_hand = [n for n in pending_hand if n not in seated_set]
            pending_vac = [n for n in pending_vac if n not in seated_set]
            rounds.append(len(seated_now))
            detail = ' '.join(f'{nm} {c}' for nm, c in per_round.items() if c)
            print(f'  round {r}: seated {len(seated_now)} — regrown {len(seated_now) - carried_now} ({detail}), carried {carried_now}; {len(pending_vac)} vacancies still pending')
            if not seated_now:
                print(f'GROW REFUSED at round {r}: {len(pending_vac)} vacancies no priming regrows from their vocabulary — the germ names them:')
                for n in pending_vac:
                    print(f'  {n} (vocabulary: {" ".join(sorted(keys[n])) or "—"}; hint: {" ".join(marker_needs.get(n, [])) or "—"})')
                sys.exit(1)
        order = [entry[n] for n in seated_order]
        storey = seated_round
        # tighten: a regrown body carries its search chain; replace it by the same shape over
        # only the theorems its proof term actually used (the elaborator's reading), judged
        # once against the finished artifact — the artifact is read, so its bodies read as proofs
        regrown_by = {}
        for n in seated_order:
            if n not in carried:
                m = re.search(r':=\n((?:.|\n)*?)\n\n/-- info:', seated_text[n])
                regrown_by[n] = m.group(1) if m else None
        grown_lines = list(prefix)
        for n in seated_order:
            grown_lines.append(seated_text[n]); grown_lines.append('')
        gf = tempfile.NamedTemporaryFile('w', suffix='.lean', prefix='crawl-grown-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
        gf.write('\n'.join(grown_lines + ([footer] if footer else [])) + '\n'); gf.close()
        resn = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', 'needs', gf.name] + SCOPE, capture_output=True, text=True)
        os.unlink(gf.name)
        used = {}
        for l in resn.stdout.splitlines():
            n, sep, deps = l.partition(' <- ')
            if sep: used[n] = set(deps.split())
        tight_cands = []
        for n in seated_order:
            if n in carried: continue
            body_now = seated_text[n].split(' :=\n', 1)[1].split('\n\n/-- info:')[0]
            cites = [t for t in derived_cites_all(n) if t in used.get(n, set())]
            for k, (pname, pbody) in enumerate(primings):
                if '{cite}' not in pbody and '{rws}' not in pbody and '{chains|' not in pbody:
                    continue
                cand = '\n'.join(('  ' + l if l else l) for l in instantiate(pbody, cites, n).splitlines())
                if cand != body_now:
                    tight_cands.append((n, k, cites))
        if tight_cands:
            failed = judge(grown_lines, tight_cands)
            tightened, done = 0, set()
            for i, (n, k, cites) in enumerate(tight_cands):
                if i in failed or n in done: continue
                seat_regrown(n, k, cites); tally[primings[k][0]] -= 1; tightened += 1; done.add(n)
            print(f'the tighten: {tightened} regrown bodies narrowed to the citations their proof terms use')
        print(f'the drain, grown: {len(rounds)} rounds — ' + ' '.join(str(c) for c in rounds) + f'; {tried} candidates judged')
        lb = sum(1 for n, h in kept_hint.items() if h)
        print(f'the hints: {lb} load-bearing (kept), {sum(1 for n in marker_needs if n in kept_hint and not kept_hint[n])} derivable (dropped)')
    else:
        for r_i, count in enumerate(rounds, start=1):
            names = [n for _, n, _ in order if storey[n] == r_i]
            prefix_lines = list(prefix)
            for _, n, _ in order:
                if storey[n] < r_i:
                    prefix_lines.append(seated_text[n]); prefix_lines.append('')
            per_round = {nm: 0 for nm, _ in primings}
            cands = [(n, k) for n in names for k in range(len(primings))]
            failed_idx = judge(prefix_lines, cands)
            failed = set(cands[i] for i in failed_idx)
            pending = []
            for n in names:
                chosen = next((k for k in range(len(primings)) if (n, k) not in failed), None)
                if chosen is None:
                    seated_text[n] = by_name[n].rstrip('\n')
                    if germ_mode:
                        seated_text[n] = hand_with_receipt(n)
                    carried.append(n); pending.append(n)
                else:
                    pname, pbody = primings[chosen]
                    stmt, receipts = split_block(by_name[n])
                    if germ_mode or not receipts:
                        receipts = receipt_for(n)
                    body = instantiate(pbody, ordered_needs(n), n)
                    body = '\n'.join(('  ' + l if l else l) for l in body.splitlines())
                    seated_text[n] = stmt + ' :=\n' + body + '\n\n' + receipts
                    tally[pname] += 1; per_round[pname] += 1
            detail = ' '.join(f'{nm} {c}' for nm, c in per_round.items() if c)
            print(f'  storey {r_i}: {count} vacancies — regrown {count - len(pending)} ({detail}), carried {len(pending)}')
            if germ_mode:
                dead = [n for n in pending if re.search(r':=\s*sorry\s*$', strip_receipts(by_name[n]).strip())]
                if dead:
                    print(f'GROW REFUSED at storey {r_i}: {len(dead)} vacancies no priming regrows — the germ names them:')
                    for n in dead: print(f'  {n} (waiting on: {" ".join(ordered_needs(n)) or "—"})')
                    sys.exit(1)
    total = len(theorems)
    print(f'the bodies: {total - len(carried)} of {total} regrown from {len(primings)} primings — '
          + ', '.join(f'{nm} {c}' for nm, c in tally.items()))
    if germ_mode:
        def is_vacancy(n):
            _, receipts = split_block(by_name[n])
            core = by_name[n][:by_name[n].rfind('\n/-- info:')] if receipts else by_name[n]
            return re.search(r':=\s*sorry\s*$', core.strip()) is not None
        vacancies = [n for _, n, _ in theorems if is_vacancy(n)]
        regrowable_hand = [n for _, n, _ in theorems if not is_vacancy(n) and n not in carried]
        def vacancy_text(n):
            stmt, _ = split_block(by_name[n])
            waits = ' '.join(kept_hint.get(n, []))
            if waits:
                return f'-- held (waiting on: {waits})\n{stmt} := sorry\n-- end'
            return f'{stmt} := sorry'
        def hand_text(n):
            b = by_name[n].rstrip('\n')
            rt = b.rfind('\n/-- info:')
            return (b[:rt] if rt != -1 else b).rstrip('\n')
        germ_text = list(prefix)
        for _, n, _ in order:
            germ_text.append(hand_text(n) if n in carried else vacancy_text(n))
            germ_text.append('')
        if footer:
            germ_text.append(footer)
        settled = '\n'.join(germ_text) + '\n'
        current = open(germ_path).read()
        germ_bytes, settled_bytes = len(current.encode()), len(settled.encode())
        print(f'the germ: {germ_bytes} bytes — {len(vacancies)} vacancies, {len(carried)} hand bodies, '
              f'{len(regrowable_hand)} hand bodies now regrowable; settled the germ reads {settled_bytes} bytes')
        if settle_mode:
            open(germ_path, 'w').write(settled)
            print(f'the germ settled: {settled_bytes} bytes ({germ_bytes - settled_bytes} shed) -> {germ_path}')
        elif check_mode:
            if settled != current:
                print(f'the germ is not its own settle: {germ_path} differs from its settle by '
                      f'{abs(germ_bytes - settled_bytes)} bytes (bin/counter grow --settle)')
                sys.exit(1)
            print(f'the germ is its own settle: {germ_path} stands minimal and in derived order')
    if germ_mode:
        grown_all = '\n'.join(list(prefix) + [seated_text[n] for _, n, _ in order])
        prose = [l for l in grown_all.splitlines() if l.startswith('--')]
        hinted = sum(1 for n, h in kept_hint.items() if h)
        # the grown trail as one file, for the kernel's readings below (kinds, census)
        grown = list(prefix)
        for _, n, _ in order:
            grown.append(seated_text[n]); grown.append('')
        if footer:
            grown.append(footer)
        cf = tempfile.NamedTemporaryFile('w', suffix='.lean', prefix='crawl-census-', dir=os.environ.get('TMPDIR', '/tmp'), delete=False)
        cf.write('\n'.join(grown) + '\n'); cf.close()
        resk = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', 'kinds', cf.name] + SCOPE, capture_output=True, text=True)
        kinds = dict(l.split() for l in resk.stdout.splitlines() if len(l.split()) == 2)
        print('the standards (foam-safe at this build; what the compiler vouches for by construction, and what it counts):')
        print(f'  axiom-free ........ {total} receipts minted into the artifact; every one checked at the gate below')
        print(f'  sorry-free ........ {len(vacancies)} vacancies, every one regrown (a refusal is red, never carried)')
        print(f'  order derived ..... the rounds are the storeys: {" ".join(str(c) for c in rounds)}')
        print(f'  germ minimal ...... {"its own settle" if settled == current else "NOT its own settle — bin/counter grow --settle"}')
        print(f'  contact width ..... {total - len(carried)} grown bodies: one citation per move, by construction')
        print(f'  comment-free ...... the artifact carries {len(prose)} lines of prose beyond its receipts')
        print(f'  the tamper surface  {len(carried)} hand bodies (the custodian\'s word), {hinted} routes kept, reach {reach}, budget {budget}')
        # treaty coverage: theorems are covered by construction (elaboration checks every one); the
        # treaty's blind spot is a carrier no assay ever evaluates — it could change with every row identical
        import glob as _glob
        assay_text = ''
        for af in _glob.glob('assays/*.lean'):
            lines = open(af).read().splitlines()
            imps = [l.split()[1] for l in lines if l.startswith('import ')]
            if imps and imps[-1] == NS_NAME:
                assay_text += '\n'.join(lines) + '\n'
        # a row computes a Bool: only a data carrier can be evaluated by one. a prop carrier's treaty
        # is its theorems; a sort carrier is evaluated through its inhabitants, never by name
        data = [c for c in cnames if kinds.get(c, 'data') == 'data']
        props = [c for c in cnames if kinds.get(c) == 'prop']
        sorts = [c for c in cnames if kinds.get(c) == 'sort']
        covered = [c for c in data if re.search(r'\b' + re.escape(c) + r'\b', assay_text)]
        uncovered = [c for c in data if c not in covered]
        print(f'  treaty coverage ... {len(covered)} of {len(data)} data carriers evaluated by an assay'
              + (f'; unevaluated: {" ".join(uncovered)}' if uncovered else '')
              + f'; beyond a row\'s reach: {len(props)} relations ({" ".join(props)}), {len(sorts)} types ({" ".join(sorts)})')
    # the ceiling: the kernel's own census of the trail's proof shapes (bin/judge.lean census),
    # so the yield reads against what the three moves could reach at all
    res = subprocess.run(['lake', 'env', 'lean', '--run', 'bin/judge.lean', 'census', cf.name] + SCOPE, capture_output=True, text=True)
    os.unlink(cf.name)
    cls = dict(l.split() for l in res.stdout.splitlines() if len(l.split()) == 2)
    if cls:
        carried_set = set(carried)
        row = []
        for c in ['rfl', 'citation', 'induction', 'term', 'cases']:
            names = [n for n, k in cls.items() if k == c]
            row.append(f'{c} {sum(1 for n in names if n not in carried_set)}/{len(names)}')
        reach = [n for n, k in cls.items() if k in ('rfl', 'citation', 'induction')]
        print(f'the grown trail\'s shapes (kernel census; regrown/class): ' + ', '.join(row))
        print(f'the three moves account for {len(reach)} of {total} bodies in the grown trail; {sum(1 for n in reach if n not in carried_set)} of them regrown from primings')
    print(f'the remainder: {len(carried)} carried from the trail (the genuine trail; named in {held_path})')
    with open(held_path, 'w') as f:
        for n in carried:
            stmt, _ = split_block(by_name[n])
            f.write(f'-- held (waiting on: an honest proof — no priming regrows it)\n{stmt} := sorry\n-- end\n')
else:
    for _, n, _ in order:
        seated_text[n] = by_name[n].rstrip('\n')

text = list(prefix)
for _, n, _ in order:
    text.append(seated_text[n]); text.append('')
if footer:
    text.append(footer)
open(out_path, 'w').write('\n'.join(text) + '\n')
print(f'the regrown trail: {out_path}')
EOF
  local status=${PIPESTATUS[0]}
  [ $status -eq 0 ] || exit $status

  if [ "$check" = 1 ] && [ -z "${CRAWL_GERM:-}" ]; then
    if cmp -s "$first" "$out"; then
      echo "the trunk is its own regrowth: ${first} already stands in derived order"
    else
      echo "the trunk is not in derived order: ${first} differs from its regrowth (bin/counter regrow ${first} --settle)"
      diff "$first" "$out" | head -20
      exit 1
    fi
  fi

  # the report mirrors the whole verdict: the gate and the treaty vectors are said here, after the
  # python half's tee has closed, so they are appended by hand or the page reads an empty treaty
  say() { printf '%s\n' "$*"; if [ -n "$report" ]; then printf '%s\n' "$*" >> "$report"; fi; }
  say "the gate on the regrown trail:"
  local gate
  gate="$(lake env lean "$out" 2>&1)"
  if [ -n "$gate" ]; then
    say "$(echo "$gate" | head -20)"
    say "crawl: the regrown trail did not elaborate silently"
    exit 1
  fi
  say "  silent and green: $(grep -c '#guard_msgs' "$out") receipts inline"

  local any=0 f probe assays
  # an assay belongs to the LAST module it imports — the one under test; the rest are its footing
  assays="$(for f in assays/*.lean; do [ "$(grep -E '^import ' "$f" | tail -1 | awk '{print $2}')" = "$name" ] && echo "$f"; done)"
  for f in $assays; do
    [ -f "$f" ] || continue
    if [ "$any" = 0 ]; then say "the treaty vectors (every assay against the regrown trail):"; any=1; fi
    probe="$(mktemp /tmp/crawl-assay.XXXXXX).lean"
    { grep -E '^import ' "$f" | grep -vE "^import ${name}\$"; cat "$out"; echo; grep -vE '^import ' "$f"; } > "$probe"
    if lake env lean "$probe" >/dev/null 2>&1; then say "  $f: identical"
    else say "  $f: PARTS"; rm -f "$probe"; exit 1; fi
    rm -f "$probe"
  done
  say "crawl: yoneda-identical at every treaty vector — the trail regrows from its own primer"
}

case "${1:-}" in
  ride) shift; ride_ear "$@" ;;
  regrow) shift; regrow_ear "$@" ;;
  grow)
    shift
    if printf '%s\n' "$@" | grep -qx -- '--settle'; then
      # a settle is a fixed point: a body that becomes a vacancy may seat in a different round,
      # so iterate until the germ grows in the order it was settled to (three passes at most)
      germ="germ/Face.lean"; for a in "$@"; do case "$a" in germ/*.lean) germ="$a";; esac; done
      for pass in 1 2 3; do
        before="$(shasum "$germ" | cut -c1-40)"
        CRAWL_GERM=1 regrow_ear --primings primings.lean "$@" || exit $?
        after="$(shasum "$germ" | cut -c1-40)"
        [ "$before" = "$after" ] && break
        echo "the settle moved the germ; pass $((pass+1)) to reach its fixed point"
      done
    else
      CRAWL_GERM=1 regrow_ear --primings primings.lean "$@"
    fi ;;
  probe) shift; CRAWL_GERM=1 regrow_ear --primings primings.lean --probe "$2" "$1" ;;
  book) shift; exec "$ROOT/bin/.book" "$@" ;;
  page) shift; exec "$ROOT/bin/.page" "$@" ;;
  *) usage ;;
esac
