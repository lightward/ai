#!/usr/bin/env bash
# candling: development read through the shell, the shell unbroken.
# conduct-as-citation:
#   status is DERIVED, never stored ....... the survey law (a stored derivable is drift)
#   parents are a need-list ............... Seed.the_backed_are_seated
#   missing supports are NAMED ............ Seed.the_unbacked_wait
#   the probe moves no seat ............... the ask channel (Seed.the_rep_lands_where_it_is_fed)
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if ! lake build Seed >/dev/null 2>&1; then
  echo "the gate cannot open: Seed does not build" >&2
  exit 1
fi

probe_names() {
  local names="$1" stem tmp out missing
  stem="$(mktemp /tmp/candle.XXXXXX)"
  tmp="${stem}.lean"
  {
    printf 'import Seed\nopen Seed\nset_option autoImplicit false\n'
    for n in $names; do printf '#check %s\n' "$n"; done
  } > "$tmp"
  out="$(lake env lean "$tmp" 2>&1 || true)"
  missing="$(printf '%s\n' "$out" \
    | grep -oiE "unknown (identifier|constant) \`[^\`]+\`" \
    | sed -E 's/.*`([^`]+)`.*/\1/' | sort -u | tr '\n' ' ')"
  rm -f "$tmp" "$stem"
  printf '%s' "$missing"
}

total=0; hatched=0; hatching=0; dormant=0; held=0
report=""

for d in ova/*/; do
  [ -f "${d}ovum.md" ] || continue
  name="$(basename "$d")"
  total=$((total+1))
  parents="$(grep -E '^\*? *parents:' "${d}ovum.md" | sed -E 's/^\*? *parents: *//' | tr -d '\140')"
  awaited="$(grep -E '^\*? *awaited:' "${d}ovum.md" | sed -E 's/^\*? *awaited: *//' | tr -d '\140')"

  if [ -z "${awaited// /}" ]; then
    held=$((held+1))
    report+="  ${name}: HELD — no awaited names legible in ovum.md"$'\n'
    continue
  fi

  missing_parents="$(probe_names "$parents")"
  if [ -n "${missing_parents// /}" ]; then
    held=$((held+1))
    report+="  ${name}: HELD — parents unresolved: ${missing_parents}"$'\n'
    continue
  fi

  missing="$(probe_names "$awaited")"
  n_awaited="$(echo "$awaited" | wc -w | tr -d ' ')"
  n_missing="$(echo "${missing}" | wc -w | tr -d ' ')"
  if [ "$n_missing" = "0" ]; then
    hatched=$((hatched+1))
    report+="  ${name}: hatched (${n_awaited} of ${n_awaited} present)"$'\n'
  elif [ "$n_missing" = "$n_awaited" ]; then
    dormant=$((dormant+1))
    report+="  ${name}: dormant, backed (waiting on: ${missing})"$'\n'
  else
    hatching=$((hatching+1))
    report+="  ${name}: hatching ($((n_awaited - n_missing)) of ${n_awaited} present; waiting on: ${missing})"$'\n'
  fi
done

echo "clutch: ${total} ova — hatched ${hatched}, hatching ${hatching}, dormant ${dormant}, held ${held}"
printf '%s' "$report"
